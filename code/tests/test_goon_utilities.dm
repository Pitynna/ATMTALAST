/// Mail must traverse real trunks and a sorting junction, including conflicting package tags.
/datum/unit_test/pneumatic_mail_delivery/Run()
	var/turf/source_turf = locate(3, 3, 1)
	var/turf/junction_turf = get_step(source_turf, EAST)
	var/obj/structure/disposalconstruct/frame = allocate(/obj/structure/disposalconstruct, source_turf, PIPE_DISPOSALS_TRUNK, EAST)
	allocate(/obj/structure/disposalpipe/trunk, source_turf, frame)
	var/obj/machinery/disposal/mail/sender = allocate(/obj/machinery/disposal/mail, source_turf)
	var/obj/structure/disposalconstruct/junction_frame = allocate(/obj/structure/disposalconstruct, junction_turf, PIPE_DISPOSALS_SORT_RIGHT, EAST)
	var/obj/structure/disposalpipe/sortjunction/junction = allocate(/obj/structure/disposalpipe/sortjunction, junction_turf, junction_frame)
	junction.sortType = 9 // Medbay.
	var/branch_dir = junction.dpdir & ~(EAST | WEST)
	var/turf/receiver_turf = get_step(junction_turf, branch_dir)
	var/obj/structure/disposalconstruct/receiver_frame = allocate(/obj/structure/disposalconstruct, receiver_turf, PIPE_DISPOSALS_TRUNK, REVERSE_DIR(branch_dir))
	allocate(/obj/structure/disposalpipe/trunk, receiver_turf, receiver_frame)
	var/obj/machinery/disposal/mail/receiver = allocate(/obj/machinery/disposal/mail, receiver_turf)
	var/turf/other_turf = get_step(junction_turf, EAST)
	var/obj/structure/disposalconstruct/other_frame = allocate(/obj/structure/disposalconstruct, other_turf, PIPE_DISPOSALS_TRUNK, WEST)
	allocate(/obj/structure/disposalpipe/trunk, other_turf, other_frame)
	var/obj/machinery/disposal/mail/other_receiver = allocate(/obj/machinery/disposal/mail, other_turf)
	var/obj/item/paper/letter = allocate(/obj/item/paper, sender)
	var/obj/item/shippingPackage/package = allocate(/obj/item/shippingPackage, sender)
	package.sealed = TRUE
	package.sortTag = 19 // A conflicting wrapper label must not override the terminal.
	TEST_ASSERT(sender.select_destination(9), "A valid department must be selectable")
	sender.mode = 2
	sender.flush()
	for(var/attempt in 1 to 50)
		if(letter.loc == receiver_turf)
			break
		sleep(0.2 SECONDS)
	TEST_ASSERT_EQUAL(letter.loc, receiver_turf, "Unwrapped mail must arrive at the selected department")
	TEST_ASSERT_EQUAL(package.loc, receiver_turf, "The terminal's selected address must override package labels")
	TEST_ASSERT_EQUAL(receiver.deliveries_received, 1, "The receiving terminal must announce one delivery")
	TEST_ASSERT_EQUAL(other_receiver.deliveries_received, 0, "The unselected branch must not receive this delivery")
	TEST_ASSERT_EQUAL(length(receiver.contents), 0, "Delivered mail must not be re-flushed by the receiver")
	TEST_ASSERT_EQUAL(length(sender.contents), 0, "Sent mail must leave the sender")

/datum/unit_test/pneumatic_mail_controls/Run()
	var/turf/test_turf = locate(1, 1, 1)
	var/obj/machinery/disposal/mail/terminal = allocate(/obj/machinery/disposal/mail, test_turf)
	TEST_ASSERT_NOT(terminal.select_destination(0), "Zero is not a destination")
	TEST_ASSERT_NOT(terminal.select_destination(2.5), "Fractional destinations must be rejected")
	TEST_ASSERT_NOT(terminal.select_destination(999), "Out-of-range destinations must be rejected")
	var/obj/item/paper/letter = allocate(/obj/item/paper, terminal)
	terminal.mode = 2
	terminal.flush()
	TEST_ASSERT_EQUAL(letter.loc, terminal, "Missing destination or trunk must not discard mail")
	TEST_ASSERT_NOT(terminal.can_contain_mobs, "Mail chutes must not accept people")
	var/obj/item/rpd/rpd = allocate(/obj/item/rpd, test_turf)
	TEST_ASSERT(rpd.can_dispense_pipe(PIPE_DISPOSALS_MAIL_CHUTE, RPD_DISPOSALS_MODE), "Mail chutes must be constructible from the RPD")
	var/obj/structure/disposalconstruct/frame = allocate(/obj/structure/disposalconstruct, test_turf, PIPE_DISPOSALS_MAIL_CHUTE)
	TEST_ASSERT_EQUAL(frame.pipe_type, terminal.type, "The frame must build a mail chute")
	TEST_ASSERT_EQUAL(frame.icon, terminal.icon, "The frame must retain the Goonstation sprite")

/datum/unit_test/glass_recycler_materials/Run()
	var/turf/test_turf = locate(1, 1, 1)
	var/obj/machinery/glass_recycler/recycler = allocate(/obj/machinery/glass_recycler, test_turf)
	recycler.stat = 0
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, test_turf)
	var/obj/item/stack/sheet/glass/sheets = allocate(/obj/item/stack/sheet/glass, test_turf, 2)
	user.put_in_hands(sheets)
	TEST_ASSERT(recycler.recycle_item(sheets, user), "Plain glass sheets must be accepted")
	TEST_ASSERT_EQUAL(recycler.glass_amount, 2 * MINERAL_MATERIAL_AMOUNT, "Sheet credit must match the actual material amount")
	for(var/index in 1 to length(recycler.products))
		var/product_path = recycler.products[index]
		var/cost = recycler.products[product_path]
		recycler.glass_amount = cost
		var/obj/item/product = recycler.create_product(index, user)
		TEST_ASSERT(product, "Every catalog entry must create its item")
		LAZYADD(allocated, product)
		TEST_ASSERT_EQUAL(recycler.glass_amount, 0, "Manufacturing must consume exactly its listed glass cost")
		TEST_ASSERT_NOT(product.reagents?.total_volume, "Manufactured vessels must be empty")
		TEST_ASSERT((product.materials?[MAT_GLASS] || 0) <= cost, "Printing must not create more raw glass than it consumes")
		TEST_ASSERT(recycler.recycling_value(product) <= cost, "Recycling a manufactured item must not create free glass")
		qdel(product)
	TEST_ASSERT_NOT(recycler.create_product(1, user), "Printing without glass must fail")
	recycler.glass_amount = 10000
	TEST_ASSERT_NOT(recycler.create_product(0, user), "Invalid product IDs must fail")
	TEST_ASSERT_NOT(recycler.create_product(1.5, user), "Fractional product IDs must fail")
	TEST_ASSERT_NOT(recycler.create_product(999, user), "Unlisted recipes must fail")
	recycler.stat = NOPOWER
	TEST_ASSERT_NOT(recycler.create_product(1, user), "Printing must require power")
	TEST_ASSERT_EQUAL(recycler.glass_amount, 10000, "Failed requests must preserve glass")

/datum/unit_test/glass_recycler_rejections/Run()
	var/turf/test_turf = locate(1, 1, 1)
	var/obj/machinery/glass_recycler/recycler = allocate(/obj/machinery/glass_recycler, test_turf)
	var/obj/item/reagent_containers/cup/beaker/beaker = allocate(/obj/item/reagent_containers/cup/beaker, test_turf)
	beaker.reagents.add_reagent("water", 10)
	TEST_ASSERT_EQUAL(recycler.recycling_value(beaker), 0, "Full vessels must not be destroyed")
	beaker.reagents.clear_reagents()
	var/obj/item/paper/attachment = allocate(/obj/item/paper, beaker)
	TEST_ASSERT_EQUAL(recycler.recycling_value(beaker), 0, "Stored objects and attachments must not be destroyed")
	attachment.forceMove(test_turf)
	ADD_TRAIT(beaker, TRAIT_NODROP, "recycler_test")
	TEST_ASSERT_EQUAL(recycler.recycling_value(beaker), 0, "No-drop objects must be rejected")
	REMOVE_TRAIT(beaker, TRAIT_NODROP, "recycler_test")
	TEST_ASSERT_EQUAL(recycler.recycling_value(beaker), 500, "An empty ordinary beaker must be accepted")
	var/obj/item/reagent_containers/cup/beaker/noreact/metal_beaker = allocate(/obj/item/reagent_containers/cup/beaker/noreact, test_turf)
	TEST_ASSERT_EQUAL(recycler.recycling_value(metal_beaker), 0, "Metal vessels must not become glass")
	var/obj/item/shard/shard = allocate(/obj/item/shard, test_turf)
	TEST_ASSERT(recycler.recycling_value(shard) <= 500, "A shard must not yield more than the cheapest glass vessel")
	var/obj/item/broken_bottle/broken = allocate(/obj/item/broken_bottle, test_turf)
	TEST_ASSERT_EQUAL(recycler.recycling_value(broken), 500, "Broken drinking bottles must be recyclable")
	var/obj/item/reagent_containers/cup/glass/bottle/bottle = allocate(/obj/item/reagent_containers/cup/glass/bottle, test_turf)
	bottle.reagents.clear_reagents()
	TEST_ASSERT(recycler.recycling_value(bottle) > 0, "Empty ordinary drinking bottles must be recyclable")
	var/obj/item/stock_parts/manipulator/component = allocate(/obj/item/stock_parts/manipulator, test_turf)
	TEST_ASSERT_EQUAL(recycler.recycling_value(component), 0, "Arbitrary machinery components must not be consumed")
