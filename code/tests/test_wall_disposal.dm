/// The compact opening must reject every supported way of putting a person inside.
/datum/unit_test/wall_disposal_rejects_mobs/Run()
	var/turf/test_turf = locate(1, 1, 1)
	var/obj/machinery/disposal/wall/bin = allocate(/obj/machinery/disposal/wall, test_turf)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, test_turf)
	var/mob/living/carbon/human/target = allocate(/mob/living/carbon/human, test_turf)
	user.grab_state = GRAB_AGGRESSIVE
	TEST_ASSERT(bin.CanPass(user, NORTH), "People must be able to walk through a wall bin's tile")
	bin.grab_attack(user, target)
	TEST_ASSERT_EQUAL(target.loc, test_turf, "An aggressive grab must not put a person inside")
	TEST_ASSERT_NOT(bin.shove_impact(target, user), "Shoves must not be handled as disposal insertion")
	TEST_ASSERT_EQUAL(target.loc, test_turf, "A shove must not put a person inside")
	bin.mouse_drop_receive(user, user)
	bin.mouse_drop_receive(target, user)
	bin.put_in(user, user)
	bin.put_in(target, user)
	bin.monkey_stuff_mob(user, user)
	bin.monkey_stuff_mob(target, user)
	sleep(3 SECONDS)
	TEST_ASSERT_EQUAL(user.loc, test_turf, "Self-climbing must be rejected, including delayed insertion")
	TEST_ASSERT_EQUAL(target.loc, test_turf, "Dragging or monkey AI must not put a person inside")
	var/obj/machinery/disposal/normal_bin = allocate(/obj/machinery/disposal, test_turf)
	TEST_ASSERT(normal_bin.can_contain_mobs, "Normal bins must still accept people")
	TEST_ASSERT_NOT(normal_bin.CanPass(user, NORTH), "Normal bins must still block walking")

/// Ordinary insertion, ejection and the pneumatic holder remain shared with floor bins.
/datum/unit_test/wall_disposal_items/Run()
	var/turf/test_turf = locate(1, 1, 1)
	var/obj/machinery/disposal/wall/bin = allocate(/obj/machinery/disposal/wall, test_turf)
	var/mob/living/carbon/human/user = allocate(/mob/living/carbon/human, test_turf)
	var/obj/item/paper/trash = allocate(/obj/item/paper, test_turf)
	user.put_in_hands(trash)
	bin.attackby(trash, user)
	TEST_ASSERT_EQUAL(trash.loc, bin, "Wall bins must accept items through the normal interaction")
	bin.eject()
	TEST_ASSERT_EQUAL(trash.loc, test_turf, "Manual ejection must return items to the floor")
	user.put_in_hands(trash)
	bin.attackby(trash, user)
	var/obj/structure/disposalholder/holder = allocate(/obj/structure/disposalholder, bin)
	holder.init(bin)
	TEST_ASSERT_EQUAL(trash.loc, holder, "A flush holder must collect the wall bin's items")
	// The holder now owns the old gas reservoir, as during a normal flush.
	bin.air_contents = new()
	trash.forceMove(bin)
	bin.flush()
	TEST_ASSERT_NOT(bin.flushing || bin.flush, "A complete flush must reset the handle and flushing state")
	TEST_ASSERT_NOT(trash.loc == bin, "Flushing must remove items from the unit")
	TEST_ASSERT(isturf(trash.loc), "A disconnected unit must safely expel its flushed items")

/// RPD frames and dismantled bins must keep their type, sprite and orientation.
/datum/unit_test/wall_disposal_construction/Run()
	var/turf/test_turf = locate(1, 1, 1)
	var/obj/item/rpd/rpd = allocate(/obj/item/rpd, test_turf)
	TEST_ASSERT(rpd.can_dispense_pipe(PIPE_DISPOSALS_WALL_BIN, RPD_DISPOSALS_MODE), "Wall bins must be available in the RPD")
	for(var/direction in GLOB.cardinal)
		var/obj/structure/disposalconstruct/frame = allocate(/obj/structure/disposalconstruct, test_turf, PIPE_DISPOSALS_WALL_BIN, direction)
		TEST_ASSERT_EQUAL(frame.pipe_type, /obj/machinery/disposal/wall, "RPD frames must build the wall variant")
		var/obj/machinery/disposal/wall/bin = allocate(frame.pipe_type, test_turf, frame)
		TEST_ASSERT_EQUAL(bin.dir, direction, "Assembly must preserve orientation")
		TEST_ASSERT_EQUAL(frame.icon, bin.icon, "Construction must use the compact sprites")
		var/obj/structure/disposalconstruct/dismantled = allocate(/obj/structure/disposalconstruct, test_turf, null, null, bin)
		TEST_ASSERT_EQUAL(dismantled.pipe_type, bin.type, "Dismantling must preserve the wall variant")
		TEST_ASSERT_EQUAL(dismantled.dir, direction, "Dismantling must preserve orientation")
		TEST_ASSERT_EQUAL(dismantled.icon, bin.icon, "Dismantling must preserve the compact sprite")
