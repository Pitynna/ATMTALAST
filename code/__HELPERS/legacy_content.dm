		var/obj/item/circuitboard/board = typepath
		return is_legacy_blocked_type(initial(board.build_path))
	return FALSE

/// Filter raw type lists before presenting content catalogs, without mutating cached callers.
/proc/legacy_available_types(list/typepaths)
	var/list/available = list()
	for(var/typepath in typepaths)
		if(!is_legacy_blocked_type(typepath))
			available += typepath
	return available
